@inject OmniPyme.Web.Services.IUsersService _usersService


<!-- ======= Sidebar ======= -->
<aside id="sidebar" class="sidebar">

	<ul class="sidebar-nav" id="sidebar-nav">

		<li class="nav-item">
			<a class="nav-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Home" ? "" : "collapsed") active" asp-controller="Home" asp-action="Index">
				<i class="bi bi-grid"></i>
				<span>Inicio</span>
			</a>
		</li><!-- End Dashboard Nav -->

		@if (await _usersService.CurrentUserIsAuthorizedAsync("ShowClient", "Client"))
		{


			<li class="nav-item">
				<a class="nav-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Clients" ? "" : "collapsed") active" asp-controller="Clients" asp-action="Index">
					<i class="bi bi-person"></i>
					<span>Clientes</span>
				</a>
			</li>

		}

		@if (await _usersService.CurrentUserIsAuthorizedAsync("showRoles", "Roles"))
		{

			<li class="nav-item">
				<a class="nav-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Roles" ? "" : "collapsed") active" asp-controller="Roles"  asp-action="Index">
					<i class="bi bi-shield-lock"></i>
					<span>Roles</span>
				</a>
			</li>
		}

		@if (await _usersService.CurrentUserIsAuthorizedAsync("ShowSale", "Sale"))
		{


			<li class="nav-item">
				<a class="nav-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Invoices" ? "" : "collapsed") active" asp-controller="Invoices" asp-action="Index">
					<i class="bi bi-file-earmark-spreadsheet"></i>
					<span>Facturas</span>
				</a>
			</li>

		}

		@if (await _usersService.CurrentUserIsAuthorizedAsync("ShowProductCategory", "ProductCategory"))
		{
			<li class="nav-item">
				<a class="nav-link @(ViewContext.RouteData.Values["Controller"].ToString()  == "ProductCategories" ? "" : "collapsed") active" asp-controller="ProductCategories" asp-action="Index">
					<i class="bi bi-tags"></i>
					<span>Categoria de producto</span>
				</a>
			</li>
		}

		@if (await _usersService.CurrentUserIsAuthorizedAsync("ShowProduct", "Product"))
		{

			<li class="nav-item">
				<a class="nav-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Glampings" ? "" : "collapsed") active" asp-controller="Products" asp-action="Index">
					<i class="bi bi-box"></i>
					<span>Glampings</span>
				</a>
			</li>
		}

		@if (await _usersService.CurrentUserIsAuthorizedAsync("ShowUsers", "Users"))
		{

			<li class="nav-item">
				<a class="nav-link @(ViewData["ActivePage"] as string == "Users" ? "" : "collapsed") active" asp-controller="Users" asp-action="Index">
					<i class="bi bi-person"></i>
					<span>Usuarios</span>
				</a>
			</li>
		}

		@if (await _usersService.CurrentUserIsAuthorizedAsync("ShowLogs", "Logs"))
		{
			<li class="nav-item">
				<a class="nav-link @(ViewContext.RouteData.Values["Controller"].ToString() == "AplicationLogs" ? "" : "collapsed") active" asp-controller="AplicationLogs" asp-action="Index">
					<i class="bi bi-code-slash"></i>
					<span>Logs</span>
				</a>
			</li>
		}

		<!-- CLIENTE: Mis reservas -->
		@if (await _usersService.CurrentUserIsAuthorizedAsync("ShowMyReservations", "Reservation"))
		{
			<li class="nav-item" id="nav-misreservas">
				<a class="nav-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Reservations" && ViewContext.RouteData.Values["Action"].ToString() == "MyReservations" ? "" : "collapsed")"
				   asp-controller="Reservations" asp-action="Index">
					<i class="bi bi-calendar-check"></i>
					<span>Mis Reservas</span>
				</a>
			</li>
		}

		<!-- ADMIN: Gestión de reservas -->
		@if (await _usersService.CurrentUserIsAuthorizedAsync("ShowReservation", "Reservation"))
		{
			<li class="nav-item">
				<a class="nav-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Reservations" ? "" : "collapsed")"
				   asp-controller="Reservations" asp-action="Index">
					<i class="bi bi-journal-bookmark-fill"></i>
					<span>Reservas</span>
				</a>
			</li>
		}


	</ul>

</aside><!-- End Sidebar-->