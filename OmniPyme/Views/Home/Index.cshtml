@{
    ViewData["Title"] = "Glamping";
}

<div class="pagetitle text-center mt-4 mb-4">
    <h1 class="fw-bold" style="font-size: 2.5rem;">Descubre tu Próxima Escapada</h1>
    <p class="text-muted fs-5">Explora experiencias únicas en nuestros glampings seleccionados</p>
</div>

<section class="section dashboard">
    <div class="row justify-content-center">

        <!-- Hero principal -->
        <div class="col-lg-10 mb-5">
            <div class="card overflow-hidden shadow-sm border-0 rounded-4">
                <div class="card-body p-0">
                    <div class="position-relative">
                        <img src="@Url.Content("https://media.istockphoto.com/id/1386869947/es/foto/glamping-carpa-abierta-con-interior-acogedor-en-un-d%C3%ADa-soleado-tienda-de-campa%C3%B1a-de-lujo-para.jpg?s=612x612&w=0&k=20&c=adCZWSHPN1n27TqGJN2mUJuhGtpz4WP2wfTtFVUg4Co=")"
                             alt="Glamping Destacado"
                             class="img-fluid w-100"
                             style="height: 420px; object-fit: cover;">

                        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-center align-items-center bg-dark bg-opacity-50 text-white text-center px-3">
                            <h2 class="fw-bold mb-2" style="font-size: 2.8rem;">Escapa a la Naturaleza</h2>
                            <p class="fs-5 mb-3">Relájate, desconéctate y vive experiencias memorables</p>
                            <a href="/Products" class="btn btn-light btn-lg rounded-pill shadow">
                                Ver Glampings
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjetas Turísticas -->
        <div class="col-lg-10">
            <div class="row g-4 justify-content-center">

                <!-- Experiencia Destacada -->
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card shadow-sm border-0 h-100 rounded-4"
                         style="background: linear-gradient(135deg, #00b09b, #96c93d); color: white; padding: 25px;">

                        <div class="card-body text-center">
                            <h5 class="card-title mb-3 fw-bold">Experiencia Destacada</h5>

                            <div class="d-flex flex-column align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center bg-white text-success shadow-sm mb-3"
                                     style="width: 70px; height: 70px;">
                                    <i class="bi bi-sun fs-2"></i>
                                </div>
                                <h6 class="fw-semibold">Tour Amanecer</h6>
                                <span class="small">Vive un amanecer inolvidable entre montañas.</span>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Actividades Disponibles -->
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card shadow-sm border-0 h-100 rounded-4" style="padding: 25px;">

                        <div class="card-body text-center">
                            <h5 class="card-title mb-3 fw-bold">Actividades Disponibles</h5>

                            <div class="d-flex flex-column align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center bg-primary text-white shadow-sm mb-3"
                                     style="width: 70px; height: 70px;">
                                    <i class="bi bi-bicycle fs-2"></i>
                                </div>
                                <h6 class="fw-semibold">6 actividades</h6>
                                <span class="text-muted small">Naturaleza, aventura y tranquilidad.</span>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Opiniones -->
                <div class="col-xxl-4 col-md-6">
                    <div class="card info-card shadow-sm border-0 h-100 rounded-4" style="padding: 25px; background:#f7f7f7;">

                        <div class="card-body text-center">
                            <h5 class="card-title mb-3 fw-bold">Opiniones de Visitantes</h5>

                            <div class="d-flex flex-column align-items-center">
                                <div class="card-icon rounded-circle d-flex align-items-center justify-content-center bg-warning text-white shadow-sm mb-3"
                                     style="width: 70px; height: 70px;">
                                    <i class="bi bi-chat-heart fs-2"></i>
                                </div>
                                <h6 class="fw-semibold">4.9 / 5.0</h6>
                                <span class="text-muted small">Basado en 328 experiencias</span>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

        <!-- Sección de "Glampings Populares" con diseño más turístico -->
        <div class="col-lg-10 mt-5">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body">

                    <h3 class="fw-bold mb-4 text-center">Glampings Populares</h3>

                    <div class="row g-4">

                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRPhAyAbNehEotJKxt2kUiOybe8pxF1jVDMXQ&s" class="img-fluid" style="height:200px; object-fit:cover;">
                                <div class="card-body text-center">
                                    <h6 class="fw-bold">Cúpula Estelar</h6>
                                    <p class="text-muted small">Desde $300000 • 34 reservas</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                                <img src="https://images.trvl-media.com/lodging/35000000/34870000/34869500/34869427/cdf09879.jpg?impolicy=resizecrop&rw=575&rh=575&ra=fill" class="img-fluid" style="height:200px; object-fit:cover;">
                                <div class="card-body text-center">
                                    <h6 class="fw-bold">Refugio del Lago</h6>
                                    <p class="text-muted small">Desde $500000 • 28 reservas</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                                <img src="https://fabricasdeglamping.com/wp-content/uploads/2023/06/TIENDA-CAMPNAA-1.jpg" class="img-fluid" style="height:200px; object-fit:cover;">
                                <div class="card-body text-center">
                                    <h6 class="fw-bold">Tienda Amanecer</h6>
                                    <p class="text-muted small">Desde $200000 • 40 reservas</p>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </div>

    </div>
</section>
