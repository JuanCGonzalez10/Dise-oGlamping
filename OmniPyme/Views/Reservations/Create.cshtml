@model ReservationDTO
@{
    ViewData["Title"] = "Nueva Reserva";
}

<div class="pagetitle">
    <h1>Reservas</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item active"><a asp-action="Index">Reservas</a></li>
            <li class="breadcrumb-item active">Nueva Reserva</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">
    <div class="card">
        <div class="card-body">
            <h5 class="card-title text-primary">Nueva Reserva</h5>

            <form asp-action="Create" method="POST" class="row g-3">

                <!-- PRODUCTO -->
                <div class="col-md-6">
                    <div class="form-floating">
                        <select asp-for="ProductId" asp-items="Model.Products" class="form-select"></select>
                        <label asp-for="ProductId"></label>
                        <span asp-validation-for="ProductId" class="text-danger"></span>
                    </div>
                </div>

                <!-- USUARIO -->
                <div class="col-md-6">
                    <div class="form-floating">
                        <select asp-for="UserId" asp-items="Model.Users" class="form-select"></select>
                        <label asp-for="UserId"></label>
                        <span asp-validation-for="UserId" class="text-danger"></span>
                    </div>
                </div>

                <!-- CHECK IN -->
                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="CheckIn" class="form-control" type="date" id="checkIn" />
                        <label asp-for="CheckIn"></label>
                        <span asp-validation-for="CheckIn" class="text-danger"></span>
                    </div>
                </div>

                <!-- CHECK OUT -->
                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="CheckOut" class="form-control" type="date" id="checkOut" />
                        <label asp-for="CheckOut"></label>
                        <span asp-validation-for="CheckOut" class="text-danger"></span>
                    </div>
                </div>

                <!-- NIGHTS (READONLY) -->
                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="Nights" class="form-control" id="nights" readonly />
                        <label asp-for="Nights"></label>
                    </div>
                </div>
                <!-- PRECIO POR NOCHE -->
                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="PricePerNight" class="form-control" id="pricePerNight" readonly />
                        <label asp-for="PricePerNight"></label>
                    </div>
                </div>
                <!-- TOTAL (READONLY) -->
                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="Total" class="form-control" id="totalPrice" readonly />
                        <label asp-for="Total"></label>
                    </div>
                </div>
                <!-- METODO-->
                <div class="col-md-6">
                    <div class="form-floating">
                        <select asp-for="PaymentMethod" asp-items="Model.PaymentMethods" class="form-select"></select>
                        <label asp-for="PaymentMethod">Método de Pago</label>
                        <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                    </div>
                </div>

                <!-- INSTRUCCIONES -->
                <div class="col-md-12">
                    <div class="alert alert-info">
                        * El precio por noche se llena automáticamente al seleccionar el producto.<br />
                        * El total y las noches se calculan automáticamente según la fecha.
                    </div>
                </div>
                <input type="hidden" asp-for="Status" />

                <div class="text-center">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>

            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function calculateNights(date1Str, date2Str) {
            if (!date1Str || !date2Str) return 0;

            const date1 = new Date(date1Str);
            const date2 = new Date(date2Str);

            if (date2 <= date1) return 0;

            const utcDate1 = Date.UTC(date1.getFullYear(), date1.getMonth(), date1.getDate());
            const utcDate2 = Date.UTC(date2.getFullYear(), date2.getMonth(), date2.getDate());

            const diffMs = utcDate2 - utcDate1;
            const oneDayMs = 1000 * 60 * 60 * 24;

            // Math.round es crucial para manejar el final del día y evitar números flotantes.
            return Math.round(diffMs / oneDayMs);
        }

        const priceMap = @Html.Raw(Json.Serialize(Model.ProductPricesMap ?? new Dictionary<int, decimal>()));

        function calculate() {
            const checkInValue = document.getElementById("checkIn").value;
            const checkOutValue = document.getElementById("checkOut").value;
            const productId = Number(document.getElementById("ProductId").value);

            // Obtener elementos de salida
            const nightsInput = document.getElementById("nights");
            const totalPriceInput = document.getElementById("totalPrice");
            const pricePerNightInput = document.getElementById("pricePerNight");

            let pricePerNight = 0;
            let nights = 0;

            const priceKey = productId.toString();
            // 1. Obtener el precio por noche del producto seleccionado
            if (productId > 0 && priceMap[priceKey]) {
                // El priceMap tiene claves numéricas (int) o convertibles a ellas
                pricePerNight = parseFloat(priceMap[priceKey]);
                pricePerNightInput.value = pricePerNight.toFixed(2);
            } else {
                pricePerNightInput.value = "";
            }

            nightsInput.value = 0;
            totalPriceInput.value = "";

            // 2. Calcular las noches
                if (checkInValue && checkOutValue) {
                nights = calculateNights(checkInValue, checkOutValue);
                nightsInput.value = nights;
            }

            // 3. Calcular el total
            if (nights > 0 && pricePerNight > 0) {
                const total = nights * pricePerNight;
                totalPriceInput.value = total.toFixed(2); // Muestra el total con 2 decimales
            }
        }

        document.getElementById("checkIn").addEventListener("change", calculate);
        document.getElementById("checkOut").addEventListener("change", calculate);
        document.getElementById("ProductId").addEventListener("change", calculate);
        calculate();
    </script>
}

