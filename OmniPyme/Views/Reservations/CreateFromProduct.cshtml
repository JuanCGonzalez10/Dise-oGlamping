@model OmniPyme.Web.DTOs.ReservationDTO

@{
    ViewData["Title"] = "Nueva Reserva";
}

<div class="pagetitle">
    <h1>Crear Reserva</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-controller="Reservations" asp-action="Index">Mis Reservas</a></li>
            <li class="breadcrumb-item active">Nueva</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Datos de la Reserva</h3>
        </div>

        <div class="card-body">

            <form asp-action="CreateFromProduct" method="post">

                @* ProductId oculto *@
                <input type="hidden" asp-for="ProductId" />

                @* UserId oculto — siempre el del cliente *@
                <input type="hidden" asp-for="UserId" />

                @* PaymentMethod oculto - Necesario para pasar el [Required] validation en el DTO *@
                <input type="hidden" asp-for="PaymentMethod" />

                <input type="hidden" asp-for="PricePerNight" id="ProductPricePerNight" />
                <input type="hidden" asp-for="Status" />

                <div class="mb-3">
                    <label class="form-label">Glamping</label>
                    <select asp-for="ProductId" asp-items="Model.Products" class="form-select" disabled></select>
                    <span class="text-danger" asp-validation-for="ProductId"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Check-In</label>
                        <input asp-for="CheckIn" class="form-control" type="date" />
                        <span class="text-danger" asp-validation-for="CheckIn"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Check-Out</label>
                        <input asp-for="CheckOut" class="form-control" type="date" />
                        <span class="text-danger" asp-validation-for="CheckOut"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Noches</label>
                    <input id="NightsDisplay" class="form-control" disabled />
                </div>

                <div class="mb-3">
                    <label class="form-label">Total Estimado</label>
                    <input id="TotalDisplay" class="form-control" disabled />
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Confirmar Reserva
                </button>

                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function calculateNights(date1Str, date2Str) {
            if (!date1Str || !date2Str) return 0;

            const date1 = new Date(date1Str);
            const date2 = new Date(date2Str);

            if (date2 <= date1) return 0;

            const utcDate1 = Date.UTC(date1.getFullYear(), date1.getMonth(), date1.getDate());
            const utcDate2 = Date.UTC(date2.getFullYear(), date2.getMonth(), date2.getDate());

            const diffMs = utcDate2 - utcDate1;
            const oneDayMs = 1000 * 60 * 60 * 24;

            return Math.round(diffMs / oneDayMs);
        }

        // CRÍTICO: Leer el precio por noche del input hidden
        //const pricePerNight = parseFloat(document.getElementById("ProductPricePerNight").value) || 0;

        function calcularNightsYTotal() {
            const checkInValue = document.getElementById("CheckIn").value;
            const checkOutValue = document.getElementById("CheckOut").value;

            const nightsDisplay = document.getElementById("NightsDisplay");
            const totalDisplay = document.getElementById("TotalDisplay");

            nightsDisplay.value = "0";
            totalDisplay.value = "0";

            if (!checkInValue || !checkOutValue) {
                return;
            }
            const pricePerNight = parseFloat(document.getElementById("ProductPricePerNight").value) || 0;
            // 1. Calcular noches usando la nueva función
            const nights = calculateNights(checkInValue, checkOutValue);

            if (nights > 0) {
                nightsDisplay.value = nights;

                // 2. Calcular el total
                if (pricePerNight > 0) {
                    const total = nights * pricePerNight;

                    totalDisplay.value = total.toLocaleString('es-CO', {
                        style: 'currency',
                        currency: 'COP', // Ajusta la moneda si es necesario
                        minimumFractionDigits: 2
                    });
                }
            }
        }

        document.getElementById("CheckIn").addEventListener("change", calcularNightsYTotal);
        document.getElementById("CheckOut").addEventListener("change", calcularNightsYTotal);

        calcularNightsYTotal();
    </script>
}

